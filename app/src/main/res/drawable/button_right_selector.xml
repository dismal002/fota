<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/theme_button_bg_pressed_color"/>
                    <corners
                        android:topRightRadius="25dp"
                        android:bottomRightRadius="25dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/theme_button_bg_normal_color"/>
                    <stroke
                        android:width="0.5dp"
                        android:color="@color/theme_button_bg_border_color"/>
                    <corners
                        android:topRightRadius="25dp"
                        android:bottomRightRadius="25dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
