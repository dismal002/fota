<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="@dimen/activity_title_height">
    <FrameLayout
        android:id="@+id/left_menu_layout"
        android:paddingLeft="10dp"
        android:paddingRight="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <ImageView
            android:id="@+id/left_menu"
            android:background="@drawable/options_selector"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@mipmap/export_applogo"
            android:layout_centerVertical="true"/>
        <ImageView
            android:layout_gravity="top|right"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/red_dot"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/public_title_size"
        android:textColor="@color/theme_title_color"
        android:id="@+id/txt_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:layout_toRightOf="@+id/left_menu_layout"
        android:layout_centerVertical="true"/>
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <RelativeLayout
        android:id="@+id/btn_pop"
        android:background="@drawable/options_selector"
        android:clickable="true"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true">
        <ImageView
            android:background="@mipmap/settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</LinearLayout>
